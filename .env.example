# =============================================================================
# .env.example — Environment variable template
# =============================================================================
# Copy this file to .env and fill in the values for local development.
# NEVER commit your .env file — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   # python-dotenv loads .env automatically via load_dotenv()
# =============================================================================

# ---------------------------------------------------------------------------
# Model serving paths
# ---------------------------------------------------------------------------
# Path to the MLflow model artifact directory (contains MLmodel + model.pkl)
MODEL_DIR=/app/model

# Path to the fitted sklearn preprocessing pipeline (pipeline.pkl)
# Set by Phase 1. For Phase 0, this variable is defined but not yet used.
PIPELINE_PATH=/app/model/pipeline.pkl

# ---------------------------------------------------------------------------
# Classification threshold
# ---------------------------------------------------------------------------
# Probability threshold above which a customer is predicted to churn.
# Chosen via threshold analysis (Phase 3). Can be tuned without rebuilding.
PREDICTION_THRESHOLD=0.35

# ---------------------------------------------------------------------------
# MLflow configuration
# ---------------------------------------------------------------------------
# URI for the MLflow tracking server.
# Local file-based (default):  file://./mlruns
# Local tracking server:       http://localhost:5000
MLFLOW_TRACKING_URI=file://./mlruns

# Name of the MLflow experiment for training runs.
MLFLOW_EXPERIMENT_NAME=Telco Churn

# MLflow run ID whose artifacts are baked into the Docker image.
# Set automatically by CI/CD from the Model Registry; set manually for local builds.
MLFLOW_RUN_ID=3b1a41221fc44548aed629fa42b762e0

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
